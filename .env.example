# Copy to .env only when connecting to a verified DEVELOPMENT AWS environment.
# npm run dev:local works without this file and ignores remote DB/pool settings.
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Use a no-client-secret app client with ALLOW_USER_PASSWORD_AUTH enabled.
# Use a verified TLS connection and a narrowly scoped application DB role.
DATABASE_URL=
DATABASE_TLS=true
# Aurora Express development deployment uses IAM tokens, never a DB password.
# Keep false for an ordinary password-authenticated PostgreSQL server.
DATABASE_IAM_AUTH=false
DATABASE_REGION=ap-south-1
# RDS CA trust is required when using node-postgres TLS. Supply the verified AWS
# CA bundle through NODE_EXTRA_CA_CERTS when starting Node; never disable TLS.
# NODE_EXTRA_CA_CERTS=C:/path/to/verified-rds-global-bundle.pem
CORE_API_URL=http://127.0.0.1:4000
DISCOVERY_API_URL=http://127.0.0.1:4100
# Server-only Photon-compatible place search. Local development has a modest
# public-demo default; production requires an explicitly chosen endpoint.
PHOTON_API_URL=
# Set this to the exact HTTPS website origin when deploying (no trailing slash).
APP_ORIGIN=
CORE_PORT=4000
WEB_PORT=3000
DISCOVERY_PORT=4100

# Never enable synthetic accounts on a deployment. The launcher generates a
# temporary session signing secret for local mode; do not save or commit one.
ENABLE_LOCAL_DEMO=false
