{
  "name": "@goa/core-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/rds-signer": "^3.1154.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.914.0",
    "@electric-sql/pglite": "^0.3.14",
    "@fastify/aws-lambda": "^6.0.0",
    "aws-jwt-verify": "^5.1.1",
    "fastify": "^5.12.7",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.157",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
